          "values": [
            {
              "content": "=Analise a mensagem de contato abaixo de um possível cliente da BStech (empresa de tecnologia/sites/sistemas).\nResponda SOMENTE em formato JSON, sem nenhum texto antes ou depois, assim:\n{\"nota\": (0 a 10), \"categoria\": \"quente/morno/frio\", \"proxima_acao\": \"sugestão curta de próximo passo\"}\n\nMensagem do lead: {{ $('Google Sheets Trigger').item.json.Mensagem }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
