    {
      "parameters": {
        "jsCode": "const texto = $input.first().json.content.parts[0].text;\nconst textoLimpo = texto.replace(/```json/g, '').replace(/```/g, '').trim();\nconst dados = JSON.parse(textoLimpo);\n\nreturn [{ json: dados }];"
